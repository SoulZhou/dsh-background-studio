{
  "name": "dsh-background-studio",
  "version": "0.3.0",
  "description": "Multi-style backgrounds for DeepSeek Harness: six palettes, your own image, or any solid color, with adjustable backdrop opacity and a dedicated Background settings page.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoulZhou/dsh-background-studio.git"
  },
  "homepage": "https://github.com/SoulZhou/dsh-background-studio#readme",
  "bugs": {
    "url": "https://github.com/SoulZhou/dsh-background-studio/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "background",
    "wallpaper",
    "appearance"
  ],
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "assets/icon-512.png",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "screenshots/*.png",
    "screenshots/*.jpg"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1"
  }
}
